{
  "name": "CMRSARathi Criterion 5",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && flask --app run seed-demo",
  "postAttachCommand": "HOST=0.0.0.0 python run.py",
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "CMRSARathi Criterion 5",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}